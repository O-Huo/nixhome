+/* Counted events use preallocated queue items, including when signaled in ISR. */
+struct nvkms_event_t {
+    nv_kthread_q_item_t item;
+    spinlock_t lock;
+    NvU64 pending;
+    NvBool queued;
+    NvBool enabled;
+    /* cancel and ref_ptr->ptr are protected by nvkms_lock. */
+    NvBool cancel;
+    nvkms_timer_proc_t *proc;
+    struct nvkms_ref_ptr *ref_ptr;
+    NvU32 dataU32;
+};
+
+static void nvkms_destroy_event(struct nvkms_event_t *event)
+{
+    nvkms_dec_ref(event->ref_ptr);
+    nvkms_free(event, sizeof(*event));
+}
+
+static void nvkms_event_callback(void *arg)
+{
+    struct nvkms_event_t *event = arg;
+    unsigned long flags;
+    NvU64 count;
+
+    nvkms_read_lock_pm_lock();
+    down(&nvkms_lock);
+
+    spin_lock_irqsave(&event->lock, flags);
+    /* Bound each batch so a busy channel yields to other queued work. */
+    count = NV_MIN(event->pending, 64);
+    event->pending -= count;
+    spin_unlock_irqrestore(&event->lock, flags);
+
+    while (count-- && !event->cancel && event->ref_ptr->ptr != NULL) {
+        event->proc(event->ref_ptr->ptr, event->dataU32);
+    }
+
+    spin_lock_irqsave(&event->lock, flags);
+    if (event->pending != 0 && !event->cancel) {
+        /*
+         * Keep queued set until the last batch finishes. A signal racing with
+         * this callback either joins that batch or schedules the next one.
+         * nv_kthread_q allows an item to reschedule itself.
+         */
+        nvkms_queue_work(&nvkms_kthread_q, &event->item);
+    } else {
+        event->queued = NV_FALSE;
+    }
+    spin_unlock_irqrestore(&event->lock, flags);
+
+    if (event->cancel) {
+        nvkms_destroy_event(event);
+    }
+
+    up(&nvkms_lock);
+    nvkms_read_unlock_pm_lock();
+}
+
+nvkms_event_handle_t *nvkms_alloc_event(nvkms_timer_proc_t *proc,
+                                       struct nvkms_ref_ptr *ref_ptr,
+                                       NvU32 dataU32)
+{
+    struct nvkms_event_t *event = nvkms_alloc(sizeof(*event), NV_TRUE);
+
+    if (event == NULL) {
+        return NULL;
+    }
+
+    event->proc = proc;
+    event->ref_ptr = ref_ptr;
+    event->dataU32 = dataU32;
+    nvkms_inc_ref(ref_ptr);
+    spin_lock_init(&event->lock);
+    nv_kthread_q_item_init(&event->item, nvkms_event_callback, event);
+    return event;
+}
+
+void nvkms_signal_event(nvkms_event_handle_t *event)
+{
+    unsigned long flags;
+
+    spin_lock_irqsave(&event->lock, flags);
+    if (!event->enabled) {
+        spin_unlock_irqrestore(&event->lock, flags);
+        return;
+    }
+    event->pending++;
+    if (!event->queued) {
+        event->queued = NV_TRUE;
+        nvkms_queue_work(&nvkms_kthread_q, &event->item);
+    }
+    spin_unlock_irqrestore(&event->lock, flags);
+}
+
+void nvkms_activate_event(nvkms_event_handle_t *event, NvU32 dataU32)
+{
+    unsigned long flags;
+
+    spin_lock_irqsave(&event->lock, flags);
+    WARN_ON(event->enabled);
+    event->dataU32 = dataU32;
+    event->enabled = NV_TRUE;
+    spin_unlock_irqrestore(&event->lock, flags);
+}
+
+void nvkms_free_event(nvkms_event_handle_t *event)
+{
+    unsigned long flags;
+    NvBool queued;
+
+    if (event == NULL) {
+        return;
+    }
+
+    /* The caller has stopped signalers and holds nvkms_lock. */
+    event->cancel = NV_TRUE;
+    spin_lock_irqsave(&event->lock, flags);
+    queued = event->queued;
+    spin_unlock_irqrestore(&event->lock, flags);
+
+    if (!queued) {
+        nvkms_destroy_event(event);
+    }
+    /* Otherwise the queued worker destroys it without calling proc. */
+}
