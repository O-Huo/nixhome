+// Display awaken notification traversal holds the display low-latency lock.
+// A channel may be shared by the GPUs of a device; lock them in instance order.
+static NvU32 _lockDisplayEventList(INotifier *pNotifier,
+                                 KernelDisplay **ppDisplays)
+{
+    DispChannel *pChannel = dynamicCast(pNotifier, DispChannel);
+    OBJGPU *pGpu;
+    NvU32 gpuMask, gpuInstance = 0, count = 0;
+
+    NV_ASSERT(pChannel != NULL);
+    gpuMask = gpumgrGetGpuMask(GPU_RES_GET_GPU(pChannel));
+    while ((pGpu = gpumgrGetNextGpu(gpuMask, &gpuInstance)) != NULL)
+    {
+        KernelDisplay *pDisplay = GPU_GET_KERNEL_DISPLAY(pGpu);
+        if (pDisplay != NULL)
+        {
+            kdispAcquireLowLatencyLock(&pDisplay->lowLatencyLock);
+            ppDisplays[count++] = pDisplay;
+        }
+    }
+    return count;
+}
+
+static void _unlockDisplayEventList(KernelDisplay **ppDisplays, NvU32 count)
+{
+    while (count != 0)
+        kdispReleaseLowLatencyLock(&ppDisplays[--count]->lowLatencyLock);
+}
+
+static void _publishDisplayEvent(INotifier *pNotifier,
+                                 PEVENTNOTIFICATION *ppList,
+                                 PEVENTNOTIFICATION pEvent)
+{
+    KernelDisplay *displays[GPUMGR_MAX_GPU_INSTANCES];
+    NvU32 count = _lockDisplayEventList(pNotifier, displays);
+    pEvent->Next = *ppList;
+    *ppList = pEvent;
+    _unlockDisplayEventList(displays, count);
+}
+
+static PEVENTNOTIFICATION _detachDisplayEvent(INotifier *pNotifier,
+                                             PEVENTNOTIFICATION *ppList,
+                                             NvHandle hClient, NvHandle hEvent)
+{
+    KernelDisplay *displays[GPUMGR_MAX_GPU_INSTANCES];
+    PEVENTNOTIFICATION *ppLink, detached = NULL;
+    NvU32 count = _lockDisplayEventList(pNotifier, displays);
+    NvU32 i;
+
+    // Consume pending native awaken bits while the old registration is still
+    // present. In particular, an idle channel's final notification must not be
+    // delivered to a replacement registration after a modeset.
+    for (i = 0; i < count; i++)
+    {
+        OBJGPU *pGpu = ENG_GET_GPU(displays[i]);
+        if (gpuIsGpuFullPower(pGpu) && !IS_DCE_CLIENT(pGpu))
+            kdispServiceAwakenIntr_HAL(pGpu, displays[i], NULL);
+    }
+
+    for (ppLink = ppList; *ppLink != NULL; ppLink = &(*ppLink)->Next)
+    {
+        if ((*ppLink)->hEventClient == hClient && (*ppLink)->hEvent == hEvent)
+        {
+            detached = *ppLink;
+            *ppLink = detached->Next;
+            detached->Next = NULL;
+            break;
+        }
+    }
+    _unlockDisplayEventList(displays, count);
+    return detached;
+}
