+static NvBool PrepareFlipOccurredEvents(
+    NVDevEvoRec *pDevEvo, const NVProposedModeSetHwState *pProposed)
+{
+    NVDispEvoRec *pDispEvo;
+    NvU32 dispIndex, apiHead, head, layer;
