diff --git a/src/v4l2/MediaControl.cpp b/src/v4l2/MediaControl.cpp
--- a/src/v4l2/MediaControl.cpp
+++ b/src/v4l2/MediaControl.cpp
@@ -1119,23 +1119,26 @@ int MediaControl::getI2CBusAddress(const string& sensorEntityName, const string&
          sinkEntityName.c_str());
     CheckAndLogError(!i2cBus, UNKNOWN_ERROR, "i2cBus is nullptr");
 
-    for (auto& entity : mEntities) {
-        int linksCount = entity.info.links;
-        MediaLink* links = entity.links;
-        char* entityName = nullptr;
-        size_t sensorEntityNameLen = sensorEntityName.length();
-        for (int i = 0; i < linksCount; i++) {
-            if (strcmp(links[i].sink->entity->info.name, sinkEntityName.c_str()) == 0) {
-                entityName = entity.info.name;
-                break;
-            }
-        }
-
-        // entityName example: "imx319 10-0010", sensorEntityName example: "imx319"
-        if (entityName && (strlen(entityName) > (sensorEntityNameLen + 1U))) {
-            *i2cBus = entityName + sensorEntityNameLen + 1;
-            LOG1("i2cBus is %s", i2cBus->c_str());
-            return OK;
+    const std::string sensorPrefix = sensorEntityName + " ";
+    for (auto& sink : mEntities) {
+        if (strcmp(sink.info.name, sinkEntityName.c_str()) != 0) continue;
+
+        for (auto& sensor : mEntities) {
+            const char* entityName = sensor.info.name;
+            if (strncmp(sensorPrefix.c_str(), entityName, sensorPrefix.length()) != 0) continue;
+
+            // Since kernel 7.2 a CVS subdevice can sit between the sensor and
+            // the IPU CSI receiver. Walk the graph instead of requiring the
+            // sensor to be linked directly to the receiver.
+            if (!checkHasSource(&sink, entityName)) continue;
+
+            // entityName example: "imx319 10-0010",
+            // sensorEntityName example: "imx319"
+            if (strlen(entityName) > sensorPrefix.length()) {
+                *i2cBus = entityName + sensorPrefix.length();
+                LOG1("i2cBus is %s", i2cBus->c_str());
+                return OK;
+            }
         }
     }
 
